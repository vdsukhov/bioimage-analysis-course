ue,"position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A color image often looks like ","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"Q7DA48TNMI"},{"type":"inlineCode","value":"(H, W, 3)","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"WxPLP4ZAa4"},{"type":"text","value":".","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"WaEUEbY5zg"}],"key":"mVTuMqAXms"}],"key":"SzUMZ4wQgH"},{"type":"listItem","spread":true,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A z-stack (3D volume) often looks like ","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"J9u2F8Lftc"},{"type":"inlineCode","value":"(Z, H, W)","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"OPiT89Mtta"},{"type":"text","value":".","position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"key":"e0vCmkUnOx"}],"key":"evqlcwzcVq"}],"key":"MeSLFzyjXu"},{"type":"listItem","spread":true,"position":{"start":{"line":106,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A time series often looks like ","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"qzqoOgtd0q"},{"type":"inlineCode","value":"(T, H, W)","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"r1qX1cdz8j"},{"type":"text","value":" or ","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"oEJyMJ7Ow7"},{"type":"inlineCode","value":"(T, Z, H, W)","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"qjQtl50vR1"},{"type":"text","value":".","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"zLCXdwl2HO"}],"key":"C4vciV1khC"}],"key":"P078gQHzUL"}],"key":"LEXz6ACFOy"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"Vo0BFd5PvA"}],"key":"dnDGsBNWOb"},{"type":"paragraph","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Different tools store axes in different orders, so the first thing you’ll always check is: shape, dtype, min/max.","position":{"start":{"line":109,"column":1},"end":{"line":109,"column":1}},"key":"l5vjuPHEju"}],"key":"NtIBA8rrjx"}],"key":"YtglWARm4o"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"strong","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"Intensity and bit-depth","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"O0CRd0AU6C"}],"key":"V0Y8ji4NiX"},{"type":"text","value":": Pixel values represent intensity (brightness). In microscopy, many images are 16-bit, which means values can go up to 65535. That’s one reason images can look “dark” by default: your display might be showing only a small slice of the available range.","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"osJuvvTMvT"}],"key":"Z5MFSaLUlH"},{"type":"heading","depth":2,"position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Image segmentation","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"kV07s4uLxl"}],"identifier":"image-segmentation","label":"Image segmentation","html_id":"image-segmentation","implicit":true,"key":"HGyAawQsxX"},{"type":"paragraph","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"text","value":"Image segmentation is a fundamental task in computer vision that involves partitioning an image into meaningful regions or segments. The goal is to simplify and organize visual information by grouping pixels with similar characteristics—such as color, intensity, or texture—into coherent structures that correspond to objects or areas of interest. By transforming raw pixel data into structured representations, image segmentation enables higher-level analysis and interpretation, serving as a critical step in applications such as medical imaging, autonomous driving, object recognition, and scene understanding.","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"Ri8omK6S2k"}],"key":"cZtBRg7n2Z"},{"type":"heading","depth":3,"position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"Types of image segmentation","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"DZogXtFx65"}],"identifier":"types-of-image-segmentation","label":"Types of image segmentation","html_id":"types-of-image-segmentation","implicit":true,"key":"brQFy9Hfg0"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Image segmentation can generally be divided into two major types: semantic segmentation and instance segmentation.","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"yTKYWqoBdX"}],"key":"J3PoBvN3ES"},{"type":"definitionList","position":{"start":{"line":123,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"definitionTerm","position":{"start":{"line":123,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"text","value":"Semantic segmentation","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"h49ZbyWYit"}],"key":"vepzAhysJw"},{"type":"definitionDescription","position":{"start":{"line":124,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"Semantic segmentation is a computer vision task that assigns a class label to every pixel in an image, grouping pixels into categories such as cell, membrane or background. It provides pixel-level predictions but does not distinguish between separate objects of the same class--for example, all cells in an image are labeled simply as “cell”, without differentiating individual cells.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"yXZSYC5IvG"}],"key":"U2fXd97yW4"},{"type":"definitionTerm","position":{"start":{"line":126,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"Instance segmentation","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"IbJ1pYjy29"}],"key":"vjW95mkDl5"},{"type":"definitionDescription","position":{"start":{"line":126,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"Instance segmentation extends semantic segmentation by not only classifying each pixel but also distinguishing between different instances of the same class. For example, instead of labeling all cells as one group, it identifies and separates each individual cell as a distinct object. This provides both pixel-level precision and object-level separation.","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"PxraawdDLq"}],"key":"lhat4fAcuD"}],"key":"Rs1Uo1QOPu"},{"type":"heading","depth":2,"position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"text","value":"Image basics","position":{"start":{"line":129,"column":1},"end":{"line":129,"column":1}},"key":"Qy13uBwDmO"}],"identifier":"image-basics","label":"Image basics","html_id":"image-basics","implicit":true,"key":"bRMVSNBJu5"},{"type":"heading","depth":3,"position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"Image intensity","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"janhs5qwHl"}],"identifier":"image-intensity","label":"Image intensity","html_id":"image-intensity","implicit":true,"key":"Hit9XLlxfd"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"Image intensity is the brightness value of a pixel in a digital image, representing the amount of light captured at a specific point. In grayscale images, it usually ranges from 0 (black) to 255 (white), while in color iamges it is defined by the intensity values of color channels such as red, green, and blue. Intensity variations help identify features and details in image processing.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"xbb4igMhQJ"}],"key":"RUItatm9Ku"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"In case of microscopy images the intensity depends on staining, exposure, gain, optics and biology. When you compare intensities across images, you’re often comparing both biology and acquisition settings, so later we will talk about normalization and controls.","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"WtdNRSE528"}],"key":"fQSGRQUN3M"},{"type":"heading","depth":3,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Noise","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"T2YY8j7W0N"}],"identifier":"noise","label":"Noise","html_id":"noise","implicit":true,"key":"FjyQf8I9fh"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"In biomedical images, imagew noise appears as unwanted grainy or speckled patterns that can make cells, tissues, or other biological structures harder to see clearly. It often occurs during image capture due to low light levels, limitations of imaging equipment, or electronic interference. This noise can blur fine details and reduce the accuracy of observations or measurements. Therefore, reducing noise is important in biomedical imaging to ensure that important biological features are clearly visible and properly analyzed.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"McbWEHg33O"}],"key":"gig5XLnAQZ"}],"key":"xWKG8G2Zyj"}],"key":"NikJ8k2Lsu"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Bioimage Analysis","url":"/","group":"Bioimage Analysis"},"next":{"title":"Classical image processing","url":"/chapter-2","group":"Bioimage Analysis"}}},"domain":"http://localhost:3000"}